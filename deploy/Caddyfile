# HTTPS automático (Let's Encrypt) para o domínio em $DOMAIN.
# O DNS do domínio precisa apontar para o servidor e as portas 80/443 precisam estar abertas.
{$DOMAIN} {
	encode gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	# Uploads de imagem passam de 8 MB só se forem abusivos; a aplicação também confere
	request_body {
		max_size 12MB
	}

	# As chaves das imagens nunca são reaproveitadas, então podem ficar em cache para sempre
	@media path /media/*
	header @media Cache-Control "public, max-age=31536000, immutable"

	reverse_proxy web:3000
}
