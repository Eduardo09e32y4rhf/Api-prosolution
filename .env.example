# Copie para .env e preencha. Nunca faça commit do .env.

# === APP ===
ENVIRONMENT=local
APP_BASE_URL=http://localhost:3000
APP_TIMEZONE=America/Sao_Paulo
# Em http puro fora de localhost, defina COOKIE_SECURE=false (só em desenvolvimento)
COOKIE_SECURE=true

# === SEGURANÇA (obrigatórias) ===
# python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Criptografa os tokens do Instagram no banco. Se perder esta chave, os usuários precisam reconectar.
ENCRYPTION_KEY=

# === DATABASE ===
# Local: SQLite. No docker-compose a URL do Postgres é montada a partir das variáveis POSTGRES_*.
DATABASE_URL=sqlite+aiosqlite:///./prosolution.db
POSTGRES_USER=prosolution
POSTGRES_PASSWORD=
POSTGRES_DB=prosolution

# === RATE LIMIT ===
# Com mais de um processo/réplica use Redis, ex.: redis://redis:6379/0
RATE_LIMIT_STORAGE_URI=memory://
# IP(s) do seu proxy reverso, para o rate limit usar o IP real do cliente
FORWARDED_ALLOW_IPS=127.0.0.1

# === E-MAIL (SMTP) — recuperação de senha ===
# Sem SMTP_HOST, em desenvolvimento o e-mail é apenas escrito no log
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Prosolution <no-reply@seudominio.com>
SMTP_STARTTLS=true
SMTP_SSL=false

# === IA ===
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# === INSTAGRAM / META ===
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_REDIRECT_URI=http://localhost:3000/dashboard/instagram/callback
INSTAGRAM_API_VERSION=v24.0

# === ASAAS (pagamentos PIX) ===
ASAAS_API_KEY=
ASAAS_BASE_URL=https://sandbox.asaas.com/api/v3
# Mesmo valor configurado no painel do Asaas (Integrações > Webhooks > Token de autenticação)
ASAAS_WEBHOOK_TOKEN=

# === PLANO PRO ===
PRO_PLAN_PRICE=97.00
PRO_PLAN_DAYS=30
