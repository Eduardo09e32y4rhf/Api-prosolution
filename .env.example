# Copie para .env e preencha. Nunca faça commit do .env.

# === APP ===
# local | staging | production
ENVIRONMENT=local
# Só para o docker-compose: domínio servido pelo Caddy com HTTPS automático.
# No compose, APP_BASE_URL vira https://$DOMAIN automaticamente.
DOMAIN=homolog.seudominio.com.br
APP_BASE_URL=http://localhost:3000
APP_TIMEZONE=America/Sao_Paulo
# Em http puro fora de localhost, defina COOKIE_SECURE=false (só em desenvolvimento)
COOKIE_SECURE=true

# === EMPRESA (rodapé, Termos e Política de Privacidade) ===
COMPANY_NAME=Razão Social da Empresa Ltda
COMPANY_DOCUMENT=54.694.364/0001-48
COMPANY_ADDRESS=Cidade - UF
CONTACT_EMAIL=contato@seudominio.com.br
PRIVACY_EMAIL=privacidade@seudominio.com.br

# === SEGURANÇA (obrigatórias) ===
# python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Criptografa os tokens do Instagram no banco. Se perder esta chave, os usuários precisam reconectar.
ENCRYPTION_KEY=

# === DATABASE ===
# Local: SQLite. No docker-compose a URL do Postgres é montada a partir das variáveis POSTGRES_*.
DATABASE_URL=sqlite+aiosqlite:///./prosolution.db
POSTGRES_USER=prosolution
POSTGRES_PASSWORD=
POSTGRES_DB=prosolution

# === BACKUP (serviço backup do docker-compose) ===
BACKUP_TIME=06:00
BACKUP_RETENTION_DAYS=7

# === MONITORAMENTO DE ERROS ===
# DSN do projeto no Sentry (sentry.io → Settings → Projects → Client Keys). Vazio = desativado.
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.0

# === RATE LIMIT ===
# Com mais de um processo/réplica use Redis, ex.: redis://redis:6379/0
RATE_LIMIT_STORAGE_URI=memory://
# IP(s) do seu proxy reverso, para o rate limit usar o IP real do cliente
FORWARDED_ALLOW_IPS=127.0.0.1

# === E-MAIL (SMTP) — recuperação de senha ===
# Sem SMTP_HOST, em desenvolvimento o e-mail é apenas escrito no log.
# Brevo:  SMTP_HOST=smtp-relay.brevo.com  SMTP_PORT=587  SMTP_USER=<login SMTP do painel>  SMTP_PASSWORD=<chave SMTP>
# Resend: SMTP_HOST=smtp.resend.com       SMTP_PORT=587  SMTP_USER=resend                 SMTP_PASSWORD=<API key>
# Teste:  python -m app.core.email voce@exemplo.com
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Prosolution <no-reply@seudominio.com>
SMTP_STARTTLS=true
SMTP_SSL=false

# === IA ===
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# === INSTAGRAM / META ===
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
# Precisa estar cadastrada no app da Meta (Login do Facebook → URIs de redirecionamento OAuth válidos)
INSTAGRAM_REDIRECT_URI=http://localhost:3000/dashboard/instagram/callback
INSTAGRAM_API_VERSION=v24.0

# === ASAAS (pagamentos PIX) ===
ASAAS_API_KEY=
ASAAS_BASE_URL=https://sandbox.asaas.com/api/v3
# Mesmo valor configurado no painel do Asaas (Integrações > Webhooks > Token de autenticação)
ASAAS_WEBHOOK_TOKEN=

# === PLANO PRO ===
PRO_PLAN_PRICE=97.00
PRO_PLAN_DAYS=30
